<?xml version="1.0" encoding="UTF-8"?>
<!--
  planning-mcp plan state machine.
  Source of truth: planning/state_machine.py + transition checks in planning/handlers.py.
  Prose: wiki/04-state-machine.md.
-->
<stateMachine name="plan-lifecycle">

  <states>
    <state id="NONE"              terminal="false" description="No plan yet."/>
    <state id="DRAFTING"          terminal="false" description="Thinking steps being recorded; not yet finalized."/>
    <state id="AWAITING_APPROVAL" terminal="false" description="Task list finalized; locked pending human approval."/>
    <state id="APPROVED"          terminal="false" description="Human approved; execution unlocked; no task started yet."/>
    <state id="IN_EXECUTION"      terminal="false" description="At least one task started."/>
    <state id="BLOCKED"           terminal="false" description="A task failed; must re-plan before continuing."/>
    <state id="AWAITING_COMPLETION" terminal="false" description="Every task is marked DONE, but the human has not yet verified the per-task evidence. COMPLETED is not reachable without them (1.9.0)."/>
    <state id="COMPLETED"         terminal="true"  description="All tasks DONE and the human confirmed the completion report."/>
    <state id="CANCELLED"         terminal="true"  description="Human rejected the plan."/>
  </states>

  <transitions>
    <transition from="NONE"              call="plan_and_think(step 1)"                 to="DRAFTING"/>
    <transition from="COMPLETED"         call="plan_and_think(step 1)"                 to="DRAFTING" note="new plan id"/>
    <transition from="CANCELLED"         call="plan_and_think(step 1)"                 to="DRAFTING" note="new plan id"/>
    <transition from="DRAFTING"          call="plan_and_think(need_more_thinking=true)" to="DRAFTING"/>
    <transition from="DRAFTING"          call="plan_and_think(final + task_list)"      to="AWAITING_APPROVAL" onError="MISSING_TASK_LIST"/>
    <transition from="AWAITING_APPROVAL" call="request_user_approval(ASK_USER)"        to="AWAITING_APPROVAL" note="blocking wait"/>
    <transition from="AWAITING_APPROVAL" call="request_user_approval(APPROVED)"        to="APPROVED" onError="APPROVAL_NOT_REQUESTED (if version not shown)"/>
    <transition from="AWAITING_APPROVAL" call="request_user_approval(REVISE)"          to="DRAFTING"/>
    <transition from="AWAITING_APPROVAL" call="request_user_approval(REJECTED)"        to="CANCELLED"/>
    <transition from="APPROVED"          call="update_task_progress(IN_PROGRESS)"      to="IN_EXECUTION"/>
    <transition from="IN_EXECUTION"      call="update_task_progress(DONE, not last)"   to="IN_EXECUTION"/>
    <transition from="IN_EXECUTION"      call="update_task_progress(DONE, last)"       to="AWAITING_COMPLETION" note="COMPLETED when PLANNING_MCP_COMPLETION_APPROVAL=false"/>
    <transition from="AWAITING_COMPLETION" call="request_user_approval(ASK_USER)"      to="AWAITING_COMPLETION" note="shows the per-task completion report and blocks"/>
    <transition from="AWAITING_COMPLETION" call="request_user_approval(APPROVED)"      to="COMPLETED"/>
    <transition from="AWAITING_COMPLETION" call="request_user_approval(REJECTED)"      to="CANCELLED"/>
    <transition from="AWAITING_COMPLETION" call="request_user_approval(REVISE, scope=TASKS)" to="IN_EXECUTION" note="rework (1.13.0): only the named tasks reopen; every other task keeps DONE and its result_log; no re-approval, the task list did not change"/>
    <transition from="AWAITING_COMPLETION" call="request_user_approval(REVISE, scope=PLAN)"  to="DRAFTING" note="whole-plan redraft for add/delete/reorder; sets rework_from_completion so the redraft carries evidence for surviving titles"/>
    <transition from="AWAITING_APPROVAL"   call="request_user_approval(APPROVED, all tasks already DONE)" to="AWAITING_COMPLETION" note="1.13.0: never unlock a plan with nothing left to run - that would skip the completion gate"/>
    <transition from="IN_EXECUTION"      call="update_task_progress(FAILED)"           to="BLOCKED"/>
    <transition from="BLOCKED"           call="plan_and_think"                          to="DRAFTING" note="same plan id, revision"/>
    <transition from="DRAFTING"          call="plan_and_think(more, budget spent, draft kept)" to="AWAITING_APPROVAL" note="1.16.0: the draft is submitted (straight to the page when there is one)"/>
    <transition from="DRAFTING"          call="plan_and_think(more, budget spent, no draft)"   to="DRAFTING+halt" note="1.16.0: circuit breaker, reason thinking_budget"/>
    <transition from="AWAITING_APPROVAL" call="plan_and_think(no revised_goal)"         to="(unchanged)" note="1.16.0: redirected; only the human's REVISE reopens a plan"/>
    <transition from="AWAITING_COMPLETION" call="plan_and_think"                        to="(unchanged)" note="1.16.0 (D26): redirected to the completion report; used to reach DRAFTING and delete every result_log"/>
    <transition from="any, request open on the page" call="plan_and_think / update_task_progress" to="(waits on the human)" note="1.16.0: held like the approval call; returns the decision, or a refusal if undecided; the thought is attached as an agent note"/>
    <transition from="COMPLETED (younger than replan_cooldown)" call="plan_and_think(same goal)" to="(unchanged)" note="1.16.0: ANSWER_USER with the finished results"/>
    <transition from="any non-terminal"  call="(circuit breaker trips)"                  to="(same status)+halt" note="1.16.0: overlay, not a status; every tool refuses with LOOP_HALTED; halt card on the page"/>
    <transition from="halted"            call="human: APPROVED (approve the draft)"     to="APPROVED" note="the draft becomes the task list"/>
    <transition from="halted"            call="human: REVISE (continue + direction)"    to="(same status)" note="guidance leads every hint until the next milestone; DRAFTING gets a fresh thinking budget"/>
    <transition from="halted"            call="human: REJECTED (cancel)"                to="CANCELLED"/>
    <transition from="any"               call="get_current_plan"                        to="(unchanged)" note="never fails; reports halted / draft_tasks / thinking_steps_left"/>
  </transitions>

  <guards>
    <guard call="update_task_progress" whenState="DRAFTING,AWAITING_APPROVAL" error="PLAN_NOT_APPROVED" note="the critical enforcement gate"/>
    <guard call="update_task_progress" whenState="BLOCKED" onOtherTask="PLAN_BLOCKED"/>
    <guard call="update_task_progress" whenState="CANCELLED" error="PLAN_CANCELLED"/>
    <guard call="request_user_approval(APPROVED)" whenState="DRAFTING" error="PLAN_NOT_READY"/>
    <guard call="any(with plan_id absent)" whenMultipleActivePlans="true" error="PLAN_AMBIGUOUS" note="response carries active_plans directory"/>
    <guard call="plan_and_think(step_number>1, goal matches no active plan)" error="GOAL_NOT_MATCHED" note="goal drift; return active_plans to pick from instead of forking a plan. step_number==1 with a new goal starts a new plan instead."/>
    <guard call="update_task_progress(DONE, task never IN_PROGRESS)" error="TASK_NOT_STARTED" note="1.9.0 - DONE is a claim of work and must be earned"/>
    <guard call="update_task_progress(DONE, an earlier task unfinished)" error="TASK_OUT_OF_ORDER"/>
    <guard call="update_task_progress(DONE, evidence-free result_log)" error="MISSING_RESULT_LOG" note="content check: bare success phrases and task-title echoes rejected regardless of length; floor PLANNING_MCP_MIN_RESULT_LOG=8 normalized chars"/>
    <guard call="update_task_progress(any)" whenState="AWAITING_COMPLETION" error="COMPLETION_PENDING"/>
    <guard call="any except get_current_plan" whenState="halted" error="LOOP_HALTED" note="1.16.0; waits instead when the halt card is open on the page"/>
    <guard call="request_user_approval(APPROVED/REJECTED/REVISE)" whenState="halted, card open on the page" error="APPROVAL_PENDING" note="D20 applied to halts: only the human lifts a halt"/>
  </guards>

  <leniencies note="rejecting these would strand a weak model">
    <leniency call="update_task_progress(IN_PROGRESS out of order)" behavior="redirect to correct task_id, ok:true"/>
    <leniency call="update_task_progress(DONE duplicate)" behavior="idempotent, point at next pending"/>
    <leniency call="update_task_progress(DONE without prior IN_PROGRESS)" behavior="accept, audit skipped_in_progress"/>
    <leniency call="plan_and_think(same goal while APPROVED/IN_EXECUTION)" behavior="redirect to in-flight task, not a new plan"/>
  </leniencies>

  <timeGuards>
    <guard name="approval-expiry" note="APPROVED/IN_EXECUTION idle past approval_ttl (1800s) -> revoke to AWAITING_APPROVAL; audit approval_expired; unreadable timestamp = expired"/>
    <guard name="approval-binding" note="any task-list change clears the pending approval; APPROVED for an unshown version -> APPROVAL_NOT_REQUESTED"/>
  </timeGuards>

</stateMachine>
